# Working files for the photo pipeline. images/_src is regenerated by tools/photos.mjs.
images/_src/

# The repo root is the GitHub Pages publish root. Source spreadsheets are working files,
# not site content - committing one would serve it publicly.
*.xlsx

# Build outputs, ~18 MB each because every photo is inlined as a data URI. Pages only serves
# index.html; committing these put 35 MB of fresh blobs into history on every nightly run.
# Regenerate with: node build.mjs
index.embedded.html
artifact.html

# Photo uploads land in images/ root and are consumed into images/_src; the site never
# serves them, and the repo root is the Pages publish root.
images/*.png
images/*.jpg
images/*.jpeg
images/*.webp
images/*.avif
images/*.zip

# the resume stamp is local bookkeeping, not site content
images/cut/.pipeline
.claude/

# Sitemap caches for the shops whose search endpoints robots.txt disallows (allsell, eldorado).
# ~37 MB of XML, refetched on demand by tools/shop-shot.py.
.cache/
__pycache__/

# Catalogue statistics for the health dashboard, regenerated by tools/dash.mjs
.dash.json
.doubts.json

# firecrawl scrape cache
.firecrawl/

# What the shops sell that the catalogue has no entry for. Regenerated by every crawl,
# 700 KB of shop titles, and the repo root is the Pages publish root.
data/unmatched.json

# Working files for the photo harvester: the shop image urls it is about to try, and what
# each one measured. Regenerated on demand, and the repo root is the Pages publish root.
.harvest.json
.probe600.json

# Resume state for tools/check-links.py --all
.links.json

# shop shelf reading: cached sitemap and the drafts built from it
.redstore-urls.json
.shelf-*.json
.tabs.json
.ym.json
.one.json

# Working files that were committed by accident and served publicly, because the repo root is
# the Pages publish root. None is referenced by any script; the harvest that produced them can
# be run again. eldorado-images-full.json alone was 36 MB of base64 JPEGs on the live site.
eldorado-images-full.json
zigzag-terms.txt
zigzag.rar
*.rar
.wanted-images.json
.links.json.bak

# Per-shop checkpoint so a run that dies resumes instead of starting over. Regenerated daily.
.scrape-partial.json

# Points the playwright MCP at Brave, because Chrome is not installed on this machine and the
# plugin's own definition asks for the "chrome" channel. Local to this machine, and the repo root
# is the Pages publish root.
.mcp.json

# unlazy gate ledgers and their check scripts - local working files
.unlazy/
